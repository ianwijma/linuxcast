{
  "name": "linuxcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.22.1 <25",
    "bun": "1.4.4"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --project tsconfig.base.json --noEmit",
    "test:unit": "node scripts/test-runner/run.ts unit",
    "test:contracts": "node scripts/test-runner/run.ts contracts",
    "test:ui": "node scripts/test-runner/run.ts ui",
    "test:integration": "node scripts/test-runner/run.ts integration",
    "test:security": "node scripts/test-runner/run.ts security",
    "test:perf": "node scripts/test-runner/run.ts perf",
    "package:deb": "node scripts/test-runner/package-deb.ts",
    "setup:electron": "node scripts/test-runner/setup-electron.ts",
    "inventory:bootstrap": "node scripts/test-runner/inventory.ts",
    "build:desktop": "node apps/desktop/build.ts",
    "start:desktop": "electron apps/desktop/dist/main.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "@electron/rebuild": "4.2.1",
    "@types/better-sqlite3": "9.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "patchedDependencies": {
    "@xyflow/system@0.0.83": "patches/@xyflow%2Fsystem@0.0.83.patch"
